		"devdoc": {
			"details": "Central admin contract for the AML demo system. Owns the global      suspicious-amount threshold, maintains an independent blacklist      registry, keeps a running transaction log, and exposes aggregate      system statistics pulled from UserRegistry, FundRequest, and      PaymentProcessor. NOTE: This contract maintains its OWN blacklist (`blacklist` / `blacklistReasons`), separate from UserRegistry's per-user `isBlacklisted` flag. The two are independent by design of the given spec — see the integration note at the bottom of this file for the implications of that split.",
			"kind": "dev",
			"methods": {
				"blacklistAddress(address,string)": {
					"params": {
						"_reason": "Human-readable reason for the blacklist action.",
						"_user": "Address to blacklist."
					}
				},
				"constructor": {
					"details": "Sets the deploying address as admin and links the three      companion contracts that make up the rest of the system.",
					"params": {
						"_fundRequest": "Address of the deployed FundRequest contract.",
						"_paymentProcessor": "Address of the deployed PaymentProcessor contract.",
						"_userRegistry": "Address of the deployed UserRegistry contract."
					}
				},
				"getAllTransactionLogs()": {
					"details": "Unbounded loop over transactionLogCounter — fine for a demo /      moderate log size, but on a live system with heavy transaction      volume this should be paginated off-chain instead.",
					"returns": {
						"_0": "Array of all TransactionLog entries, oldest first."
					}
				},
				"getBlacklistCount()": {
					"returns": {
						"_0": "Count of entries in blacklistedAddresses."
					}
				},
				"getBlacklistReason(address)": {
					"params": {
						"_user": "Address to look up."
					},
					"returns": {
						"_0": "The reason string (empty if never blacklisted or since whitelisted)."
					}
				},
				"getBlacklistedAddresses()": {
					"returns": {
						"_0": "Array of addresses."
					}
				},
				"getSuspiciousTransactions()": {
					"details": "Two-pass approach: first counts matches to size the array      correctly, then fills it. Same on-chain-cost caveat as      getAllTransactionLogs applies here.",
					"returns": {
						"_0": "Array of suspicious TransactionLog entries, oldest first."
					}
				},
				"getSystemStats()": {
					"returns": {
						"totalBlacklisted": "Total addresses ever blacklisted through this contract.",
						"totalPayments": "Total payments ever processed (from PaymentProcessor).",
						"totalRequests": "Total fund requests ever created (from FundRequest).",
						"totalSuspicious": "Total suspicious entries in this contract's transaction log.",
						"totalUsers": "Total registered users (from UserRegistry)."
					}
				},
				"getThreshold()": {
					"returns": {
						"_0": "Current threshold amount, in wei."
					}
				},
				"getTransactionLog(uint256)": {
					"params": {
						"_id": "ID of the log entry to look up."
					},
					"returns": {
						"_0": "The TransactionLog struct for _id."
					}
				},
				"isBlacklisted(address)": {
					"params": {
						"_user": "Address to check."
					},
					"returns": {
						"_0": "True if blacklisted, false otherwise."
					}
				},
				"setThreshold(uint256)": {
					"params": {
						"_newThreshold": "New threshold amount, in wei."
					}
				},
				"transferAdmin(address)": {
					"params": {
						"_newAdmin": "Address of the new admin. Cannot be the zero address        or the current admin."
					}
				},
				"whitelistAddress(address)": {
					"params": {
						"_user": "Address to whitelist."
					}
				}
			},
			"title": "AMLSystem",
			"version": 1
		},
		"userdoc": {
			"events": {
				"AdminTransferred(address,address)": {
					"notice": "Emitted when admin control is transferred to a new address."
				}
			},
			"kind": "user",
			"methods": {
				"admin()": {
					"notice": "Address administering this contract."
				},
				"blacklist(address)": {
					"notice": "This contract's own blacklist, independent of UserRegistry's."
				},
				"blacklistAddress(address,string)": {
					"notice": "Blacklists an address in this contract's own registry, with         a recorded reason. Admin only. Admin cannot blacklist itself."
				},
				"blacklistReasons(address)": {
					"notice": "Reason recorded for each blacklisted address."
				},
				"blacklistedAddresses(uint256)": {
					"notice": "List of all addresses ever blacklisted through this contract."
				},
				"fundRequest()": {
					"notice": "Reference to the deployed FundRequest contract."
				},
				"getAllTransactionLogs()": {
					"notice": "Returns every transaction log entry recorded so far."
				},
				"getBlacklistCount()": {
					"notice": "Returns the total number of addresses ever blacklisted         through this contract (including any since whitelisted)."
				},
				"getBlacklistReason(address)": {
					"notice": "Returns the recorded reason for an address's blacklisting."
				},
				"getBlacklistedAddresses()": {
					"notice": "Returns the full list of addresses ever blacklisted through         this contract."
				},
				"getSuspiciousTransactions()": {
					"notice": "Returns only the transaction log entries flagged as suspicious."
				},
				"getSystemStats()": {
					"notice": "Returns a snapshot of aggregate system statistics pulled from         across the whole AML system."
				},
				"getThreshold()": {
					"notice": "Returns the current suspicious-amount threshold."
				},
				"getTransactionLog(uint256)": {
					"notice": "Returns the full record for a given transaction log entry."
				},
				"isBlacklisted(address)": {
					"notice": "Checks whether an address is blacklisted in this contract."
				},
				"paymentProcessor()": {
					"notice": "Reference to the deployed PaymentProcessor contract."
				},
				"setThreshold(uint256)": {
					"notice": "Updates the suspicious-amount threshold used when logging         transactions. Admin only."
				},
				"suspiciousThreshold()": {
					"notice": "Amount above which a logged transaction is auto-flagged as         suspicious. Defaults to 5 ether."
				},
				"transactionLogCounter()": {
					"notice": "Running counter used to assign unique transaction log IDs (1-indexed)."
				},
				"transactionLogs(uint256)": {
					"notice": "Maps transaction log ID to its full record."
				},
				"transferAdmin(address)": {
					"notice": "Transfers admin control of this contract to a new address."
				},
				"userRegistry()": {
					"notice": "Reference to the deployed UserRegistry contract."
				},
				"whitelistAddress(address)": {
					"notice": "Removes an address from this contract's blacklist. Admin only."
				}
			},
			"version": 1
		}
