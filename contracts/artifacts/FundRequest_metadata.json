		"devdoc": {
			"details": "Handles the lifecycle of money requests created by users holding the      REQUESTER role in UserRegistry, from creation through approval,      rejection, completion, or cancellation. NOTE: This contract only manages request *state*. Actual value transfer is handled by a companion PaymentProcessor contract, which is linked via setPaymentProcessor() and is the only address authorized to call updateRequestAsApproved / updateRequestAsCompleted / updateRequestAsRejected.",
			"kind": "dev",
			"methods": {
				"cancelRequest(uint256)": {
					"params": {
						"_requestId": "ID of the request to cancel."
					}
				},
				"constructor": {
					"details": "Links this contract to a deployed UserRegistry instance.",
					"params": {
						"_userRegistryAddress": "Address of the deployed UserRegistry contract."
					}
				},
				"createRequest(uint256,string,uint8)": {
					"params": {
						"_amount": "Requested amount, in wei. Must be greater than zero.",
						"_purpose": "Human-readable reason for the request. Must not be empty.",
						"_urgency": "Requester-declared urgency level."
					},
					"returns": {
						"requestId": "The ID assigned to the newly created request."
					}
				},
				"getPendingRequests()": {
					"returns": {
						"_0": "Array of pending request IDs."
					}
				},
				"getRequest(uint256)": {
					"params": {
						"_requestId": "ID of the request to look up."
					},
					"returns": {
						"_0": "The FundRequestData struct for _requestId."
					}
				},
				"getRequestsByUser(address)": {
					"params": {
						"_user": "Address to look up."
					},
					"returns": {
						"_0": "Array of request IDs belonging to _user."
					}
				},
				"getRequestsCount()": {
					"returns": {
						"_0": "Total request count."
					}
				},
				"setPaymentProcessor(address)": {
					"params": {
						"_paymentProcessor": "Address of the deployed PaymentProcessor contract."
					}
				},
				"updateRequestAsApproved(uint256,address)": {
					"params": {
						"_funder": "Address of the user approving/funding the request.",
						"_requestId": "ID of the request being approved."
					}
				},
				"updateRequestAsCompleted(uint256)": {
					"params": {
						"_requestId": "ID of the request being completed."
					}
				},
				"updateRequestAsRejected(uint256,address,string)": {
					"params": {
						"_funder": "Address of the user rejecting the request.",
						"_reason": "Human-readable rejection reason.",
						"_requestId": "ID of the request being rejected."
					}
				}
			},
			"stateVariables": {
				"SUSPICIOUS_AMOUNT_THRESHOLD": {
					"details": "Simple on-chain heuristic threshold used to auto-flag unusually      large requests as suspicious. This is a placeholder signal only —      a real AML system would rely on off-chain risk scoring rather      than a single static amount threshold."
				}
			},
			"title": "FundRequest",
			"version": 1
		},
		"userdoc": {
			"events": {
				"PaymentProcessorSet(address)": {
					"notice": "Emitted when the admin links the PaymentProcessor contract."
				}
			},
			"kind": "user",
			"methods": {
				"cancelRequest(uint256)": {
					"notice": "Cancels a pending request. Only the original requester may         cancel, and only while the request is still PENDING."
				},
				"createRequest(uint256,string,uint8)": {
					"notice": "Creates a new fund request on behalf of the caller."
				},
				"getPendingRequests()": {
					"notice": "Returns all request IDs currently in PENDING status."
				},
				"getRequest(uint256)": {
					"notice": "Returns the full record for a given request."
				},
				"getRequestsByUser(address)": {
					"notice": "Returns all request IDs created by a given user."
				},
				"getRequestsCount()": {
					"notice": "Returns the total number of requests ever created."
				},
				"paymentProcessor()": {
					"notice": "Address of the deployed PaymentProcessor contract, the only         caller authorized to transition a request through         APPROVED/REJECTED/COMPLETED. Set once by admin after deployment."
				},
				"pendingRequestIds(uint256)": {
					"notice": "List of request IDs currently in PENDING status."
				},
				"requestCounter()": {
					"notice": "Running counter used to assign unique request IDs (1-indexed)."
				},
				"requests(uint256)": {
					"notice": "Maps request ID to its full record."
				},
				"setPaymentProcessor(address)": {
					"notice": "Links the deployed PaymentProcessor contract so it can call         updateRequestAsApproved / Completed / Rejected. Admin only         (delegated to UserRegistry's admin), intended to be called         once during system setup."
				},
				"updateRequestAsApproved(uint256,address)": {
					"notice": "Marks a request as APPROVED and assigns the funder. Callable         only by the linked PaymentProcessor contract."
				},
				"updateRequestAsCompleted(uint256)": {
					"notice": "Marks an approved request as COMPLETED once payment has been         transferred. Callable only by the linked PaymentProcessor         contract."
				},
				"updateRequestAsRejected(uint256,address,string)": {
					"notice": "Marks a pending request as REJECTED with a reason. Callable         only by the linked PaymentProcessor contract."
				},
				"userRegistry()": {
					"notice": "Reference to the deployed UserRegistry contract."
				},
				"userRequests(address,uint256)": {
					"notice": "Maps a user address to the list of request IDs they created."
				}
			},
			"version": 1
		}
	},
