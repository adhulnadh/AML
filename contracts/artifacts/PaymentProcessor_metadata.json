		"devdoc": {
			"details": "Handles FUNDER approval/rejection of fund requests and the actual      ETH transfer from FUNDER to REQUESTER. Applies a simple on-chain      AML amount threshold to flag large payments for review. Setup: after deploying UserRegistry, FundRequest, and this contract, the admin must call:   - UserRegistry.setPaymentProcessorContract(address(this))   - FundRequest.setPaymentProcessor(address(this)) so this contract is authorized to update registry stats and request state. NOTE: The AML threshold here is a simple static amount check for demonstration purposes. A production AML system would use off-chain risk scoring, behavioral pattern analysis, and sanctions-list checks rather than a single fixed ETH amount, and would not gate compliance on the \"wealth\" of either party.",
			"kind": "dev",
			"methods": {
				"approveAndPay(uint256)": {
					"params": {
						"_requestId": "ID of the request to approve and pay."
					}
				},
				"constructor": {
					"details": "Links this contract to the deployed UserRegistry and FundRequest      instances.",
					"params": {
						"_fundRequest": "Address of the deployed FundRequest contract.",
						"_userRegistry": "Address of the deployed UserRegistry contract."
					}
				},
				"getPayment(uint256)": {
					"params": {
						"_paymentId": "ID of the payment to look up."
					},
					"returns": {
						"_0": "The Payment struct for _paymentId."
					}
				},
				"getPaymentCount()": {
					"returns": {
						"_0": "Total payment count."
					}
				},
				"getPaymentsByUser(address)": {
					"params": {
						"_user": "Address to look up."
					},
					"returns": {
						"_0": "Array of payment IDs involving _user."
					}
				},
				"getThreshold()": {
					"returns": {
						"_0": "Current threshold amount, in wei."
					}
				},
				"rejectRequest(uint256,string)": {
					"params": {
						"_reason": "Human-readable reason for the rejection.",
						"_requestId": "ID of the request to reject."
					}
				},
				"setThreshold(uint256)": {
					"params": {
						"_newThreshold": "New threshold amount, in wei."
					}
				}
			},
			"title": "PaymentProcessor",
			"version": 1
		},
		"userdoc": {
			"events": {
				"RequestRejectedByFunder(uint256,address,string)": {
					"notice": "Emitted when a FUNDER rejects a pending request."
				}
			},
			"kind": "user",
			"methods": {
				"amlThreshold()": {
					"notice": "Payments strictly above this amount (in wei) are flagged as         suspicious for compliance review. Defaults to 5 ether."
				},
				"approveAndPay(uint256)": {
					"notice": "Approves a pending fund request and immediately transfers the         attached ETH to the requester. Caller must be a registered,         non-blacklisted FUNDER and must send exactly the requested         amount as msg.value."
				},
				"fundRequest()": {
					"notice": "Reference to the deployed FundRequest contract."
				},
				"getPayment(uint256)": {
					"notice": "Returns the full record for a given payment."
				},
				"getPaymentCount()": {
					"notice": "Returns the total number of payments ever processed."
				},
				"getPaymentsByUser(address)": {
					"notice": "Returns all payment IDs a given user was involved in, either         as funder or requester."
				},
				"getThreshold()": {
					"notice": "Returns the current AML flagging threshold."
				},
				"paymentCounter()": {
					"notice": "Running counter used to assign unique payment IDs (1-indexed)."
				},
				"payments(uint256)": {
					"notice": "Maps payment ID to its full record."
				},
				"rejectRequest(uint256,string)": {
					"notice": "Rejects a pending fund request. Caller must be a registered,         non-blacklisted FUNDER. No funds are transferred."
				},
				"setThreshold(uint256)": {
					"notice": "Updates the AML flagging threshold. Admin only."
				},
				"userPayments(address,uint256)": {
					"notice": "Maps a user address (funder or requester) to the payment IDs         they were involved in."
				},
				"userRegistry()": {
					"notice": "Reference to the deployed UserRegistry contract."
				}
			},
			"version": 1
		}
