{
  "name": "aml-detection-system",
  "version": "1.0.0",
  "description": "Blockchain-based Anti-Money Laundering Detection System",
  "main": "index.js",
  "author": "Your Name",
  "license": "MIT",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "deploy:local": "hardhat run scripts/deploy.js --network localhost",
    "deploy:sepolia": "hardhat run scripts/deploy.js --network sepolia",
    "deploy:goerli": "hardhat run scripts/deploy.js --network goerli",
    "deploy:mainnet": "hardhat run scripts/deploy.js --network mainnet",
    "seed": "hardhat run scripts/seed-data.js --network localhost",
    "node": "hardhat node",
    "clean": "hardhat clean",
    "coverage": "hardhat coverage",
    "verify": "hardhat verify",
    "gas-report": "REPORT_GAS=true hardhat test",
    "format": "prettier --write 'contracts/**/*.sol' 'scripts/**/*.js' 'test/**/*.js'",
    "lint": "eslint 'scripts/**/*.js' 'test/**/*.js'"
  },
  "devDependencies": {
    "hardhat": "^2.19.0",
    "@nomiclabs/hardhat-ethers": "^2.2.3",
    "@nomiclabs/hardhat-etherscan": "^3.1.7",
    "ethers": "^5.7.2",
    "chai": "^4.3.10",
    "@openzeppelin/contracts": "^5.0.0",
    "dotenv": "^16.3.1",
    "hardhat-gas-reporter": "^1.0.10",
    "solidity-coverage": "^0.8.5",
    "prettier": "^3.1.1",
    "prettier-plugin-solidity": "^1.3.1",
    "eslint": "^8.56.0"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/your-username/aml-detection-system.git"
  },
  "bugs": {
    "url": "https://github.com/your-username/aml-detection-system/issues"
  },
  "homepage": "https://github.com/your-username/aml-detection-system#readme",
  "keywords": [
    "blockchain",
    "ethereum",
    "aml",
    "anti-money-laundering",
    "hardhat",
    "solidity",
    "dapp"
  ]
}
